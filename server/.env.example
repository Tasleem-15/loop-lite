# Server Port
PORT=5000

# PostgreSQL Connection String (e.g. Neon.tech or local)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require

# JWT Secret for session signing
JWT_SECRET=your-super-secret-jwt-key

# Optional: Google Gemini API Key for sentiment tagging
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
